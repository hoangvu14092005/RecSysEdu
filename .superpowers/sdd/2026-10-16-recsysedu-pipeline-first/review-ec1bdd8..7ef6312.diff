+    recs = _recommendations(output)
+    assert [(item['course_id'], item['evidence']) for item in recs[0]['items']] == [
+        ('C_3', []), ('C_1', ['source-course:C_a'])]
+    assert [(item['course_id'], item['evidence']) for item in recs[1]['items']] == [
