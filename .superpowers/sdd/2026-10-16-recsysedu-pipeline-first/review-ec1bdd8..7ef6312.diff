+        value['warm_cohort_sizes']['valid'] = 123
+        path.write_text(json.dumps(value), encoding='utf-8')
+    else:
+        path.write_bytes(path.read_bytes() + b'tampered')
+    with pytest.raises(ValueError, match='hash'):
