+            return ScoreResult(tuple(candidate_ids), np.array([1., 2., 3.]), evidence={
+                'C_1': ('source-course:C_a',), 'C_2': ('source-course:C_b',)})
+
+    split, identity, _ = split_case
+    output = tmp_path / 'evidence-run'
